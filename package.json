{
  "name": "campus-lost-and-found",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup.ts",
    "db:check": "tsx scripts/check.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/integration-test.ts",
    "demo:prepare": "tsx scripts/prepare-local.ts",
    "demo:services": "tsx scripts/local-services.ts start",
    "demo:stop": "tsx scripts/local-services.ts stop"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "dotenv": "^17.2.3",
    "mysql2": "^3.15.3",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "redis": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
